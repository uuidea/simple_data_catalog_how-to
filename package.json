{
  "dependencies": {
    "@antora/lunr-extension": "^1.0.0-alpha.12",
    "@djencks/asciidoctor-mathjax": "^0.0.9",
    "@sntke/antora-mermaid-extension": "^0.0.8",
    "asciidoctor": "^2.0.18",
    "asciidoctor-kroki": "^0.18.1"
  },
  "scripts": {
    "build": "npx antora antora-playbook.yml --to-dir build/site",
    "build:clean": "npx antora antora-playbook.yml --clean --to-dir build/site",
    "build:pdf": "MULTI_FORMATS=pdf npx antora antora-playbook.yml --to-dir build/site",
    "build:epub": "MULTI_FORMATS=epub npx antora antora-playbook.yml --to-dir build/site", 
    "build:all": "MULTI_FORMATS=pdf,epub npx antora antora-playbook.yml --to-dir build/site",
    "build:pdf-only": "npm run clean && node extensions/build-only.js pdf",
    "build:epub-only": "npm run clean && node extensions/build-only.js epub",
    "clean": "rm -rf build pdf epub",
    "clean:all": "rm -rf build pdf epub",
    "serve": "cd build/site && python -m http.server 8000",
    "validate": "find modules/ -name \"*.adoc\" -exec asciidoctor {} \\;"
  }
}
